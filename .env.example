# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Zoho CRM self-client (https://api-console.zoho.com -> Self Client) ---
# Scopes for the grant token:
#   ZohoCRM.modules.accounts.ALL,ZohoCRM.modules.contacts.ALL,ZohoCRM.settings.fields.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Datacenter suffix: com | eu | in | com.au | jp | ca | sa | com.cn
# Elvey/Pentagon logs in at crm.zoho.com -> com.
ZOHO_DC=com

# --- Optional path overrides (otherwise config.yaml is used) ---
# KYC_FOLDER=G:\.shortcut-targets-by-id\...\Elvey KYC — People
# KYC_WORKBOOK=G:\...\Elvey Consolidated Relational Database 20260924.xlsx
